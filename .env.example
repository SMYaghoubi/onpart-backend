# ── Server ──
PORT=3000
NODE_ENV=production

# ── Database (fill after creating MySQL in Liara) ──
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=root
DB_PASS=your-db-password
DB_NAME=onpart

# ── JWT ──
JWT_SECRET=onpart_super_secret_key_change_this_2024
JWT_EXPIRES=7d

# ── SMS (sms.ir) ──
SMS_API_KEY=your-sms-api-key
SMS_LINE=your-sms-line-number
SMS_FROM=OnPart

# ── Upload ──
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ── Frontend URL (for CORS) ──
FRONTEND_URL=https://onpart.ir

# AES-256-GCM secret for saved bank cards (required in production)
CARD_ENCRYPTION_KEY=
